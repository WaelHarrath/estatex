# Database + infra
DATABASE_URL=postgresql://estatex:estatex@localhost:5434/estatex
REDIS_URL=redis://localhost:6380

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me

# Real-time (socket server origin)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# AI (optional at runtime; features degrade gracefully when unset)
# AI_PROVIDER: anthropic (default) | gemini | groq | openrouter. When unset,
# it auto-detects from whichever API key below is present.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
# Anthropic backend (AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# OpenAI-compatible backends (AI_PROVIDER=gemini | groq | openrouter)
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Stripe test mode (optional; wallet funding via checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Logging
LOG_LEVEL=debug

# Google OAuth (optional; enables "Continue with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
